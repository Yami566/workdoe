# Cloudflare Workers Static Assets consumes this file during deployment.
/*
  X-Content-Type-Options: nosniff

# First-party assets below are always requested with the release token.
/styles.css
  Cache-Control: public, max-age=31556952, immutable

/map.js
  Cache-Control: public, max-age=31556952, immutable

/dmv-area-50fe6cd3.geojson
  Content-Type: application/geo+json
  Cache-Control: public, max-age=31556952, immutable

/project-composer.js
  Cache-Control: public, max-age=31556952, immutable

/clerk-entry.js
  Cache-Control: public, max-age=31556952, immutable

# Pinned map and icon packages keep their browser cache policy.
/vendor/leaflet/*
  Cache-Control: public, max-age=31556952, immutable

/vendor/leaflet-markercluster/*
  Cache-Control: public, max-age=31556952, immutable

/vendor/tabler-icons/*
  Cache-Control: public, max-age=31556952, immutable

# Notice responses, including misses, must not pin an unavailable notice.
/vendor/clerk-notices/*
  Cache-Control: no-store

/vendor/clerk-notices-v2/*
  Cache-Control: no-store

/deer.svg
  Cache-Control: public, max-age=31556952, immutable
