{
  "name": "workdoe",
  "version": "0.1.0",
  "private": true,
  "description": "Workdoe Cloudflare launch automation and local prototype checks.",
  "scripts": {
    "test": "python -m unittest discover -s tests",
    "cf:preflight": "python scripts/cloudflare_preflight.py",
    "cf:status": "python scripts/cloudflare_launch_status.py",
    "cf:status:json": "python scripts/cloudflare_launch_status.py --json",
    "cf:resources:plan": "python scripts/cloudflare_resource_bootstrap.py --json --no-secret-probe",
    "cf:resources:apply": "python scripts/cloudflare_resource_bootstrap.py --execute --yes --no-secret-probe",
    "cf:secrets:evidence": "python scripts/cloudflare_secret_evidence.py --execute --yes --output cloudflare-secret-list.local.json",
    "cf:clerk:proof": "python scripts/cloudflare_clerk_proxy_proof.py --confirm --output clerk-proxy-proof.local.json",
    "cf:release:evidence": "python scripts/cloudflare_release_evidence.py --json",
    "cf:deploy:plan": "python scripts/cloudflare_production_deploy.py --json --secret-list-json cloudflare-secret-list.local.json --clerk-proxy-proof-json clerk-proxy-proof.local.json",
    "cf:deploy": "python scripts/cloudflare_production_deploy.py --execute --yes --secret-list-json cloudflare-secret-list.local.json --clerk-proxy-proof-json clerk-proxy-proof.local.json",
    "github:release:plan": "python scripts/github_release_status.py",
    "github:release:status": "python scripts/github_release_status.py --live",
    "github:deploy:plan": "python scripts/github_deploy_dispatch.py",
    "github:deploy": "python scripts/github_deploy_dispatch.py --execute --yes",
    "launch:handoff": "python scripts/workdoe_launch_handoff.py",
    "launch:handoff:write": "python scripts/workdoe_launch_handoff.py --write",
    "launch:doctor": "python scripts/workdoe_launch_doctor.py",
    "launch:doctor:live": "python scripts/workdoe_launch_doctor.py --live"
  },
  "devDependencies": {
    "wrangler": "4.122.0"
  }
}
